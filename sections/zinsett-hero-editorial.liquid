{% comment %}
  ZINSETT Editorial hero — Design Brief §6 Home #1.

  Full-bleed lifestyle photo with a paper scrim content panel pinned to the
  left, a Fraunces display headline, and a single terra CTA. Consumes the
  --zinsett-* brand tokens (snippets/zinsett-tokens.liquid) for the exact
  §2.1 display type scale/weight and motion timing; background/text/button
  colors come from Dawn's color-scheme system, which C-2 remapped 1:1 to the
  same §2.1 hex values, so the scrim panel stays token-driven either way.

  Asset slot awaiting media-forge: Brief §10 H-1 "Home hero" (golden-hour
  dog on a cooling mat), 16:9 desktop crop + 4:5 mobile crop. Until the
  approved photo lands, this renders Shopify's neutral placeholder art so
  the section previews correctly.
{% endcomment %}
{{ 'section-zinsett-hero-editorial.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="ZinsettHero-{{ section.id }}"
  class="zinsett-hero section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="zinsett-hero__media media{% if section.settings.image == blank %} placeholder{% endif %}">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: section.settings.image.width | divided_by: section.settings.image.aspect_ratio,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: 'high',
          class: 'zinsett-hero__image zinsett-hero__image--desktop'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg zinsett-hero__image zinsett-hero__image--desktop' }}
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      {{
        section.settings.image_mobile
        | image_url: width: 1500
        | image_tag:
          width: section.settings.image_mobile.width,
          height: section.settings.image_mobile.width | divided_by: section.settings.image_mobile.aspect_ratio,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500',
          class: 'zinsett-hero__image zinsett-hero__image--mobile'
      }}
    {%- endif -%}
  </div>

  <div class="zinsett-hero__content-wrap zinsett-hero__content-wrap--{{ section.settings.image_height }}">
    <div class="zinsett-hero__scrim color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zinsett-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- comment -%}
        h2, not h1: Dawn already renders the shop name as the page's h1 in the
        header on the index template, and this section only appears there.
        Two h1s on one page is the defect the live QA pass flagged. Styling is
        class-driven, so the heading looks identical.
      {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zinsett-hero__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="zinsett-hero__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="zinsett-hero__cta button button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ZINSETT Editorial hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-bleed hero with a paper scrim panel, per Brief §6 Home #1. Awaiting media-forge asset H-1 (golden-hour dog on cooling mat, 16:9 + 4:5 crop)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop, 16:9 recommended)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile, 4:5 recommended)",
      "info": "Optional. Falls back to the desktop image when not set."
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Desktop height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Optional small gold label above the headline."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Summer comfort, sorted."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "info": "No final copy yet — leave blank until copy-brand-guardian supplies it, or add a short benefit line."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Summer Edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Point this at the Summer Shop collection once it exists (Brief §4)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Scrim panel color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ZINSETT Editorial hero",
      "settings": {
        "heading": "Summer comfort, sorted.",
        "button_label": "Shop the Summer Edit",
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}
