{% comment %}
  ZINSETT Value props — Design Brief §6 Home #5.

  3-up: curated by pet people / tracked US delivery / easy returns. Icons
  are Dawn's existing inline SVG set (icon-paw-print, icon-truck,
  icon-return) so no new art assets are required. Heading phrases are the
  exact §6 fragments, title-cased; no longer descriptive sentence is given
  in the Brief, so the description field defaults to blank rather than
  inventing copy — schema-editable once copy-brand-guardian supplies one.
{% endcomment %}
{%- comment -%}
  Perf pass: value props is Home #5, well below the fold — async per
  Dawn's print/onload swap idiom instead of a blocking stylesheet_tag.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'section-zinsett-value-props.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="zinsett-value-props page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="zinsett-value-props__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    <ul class="zinsett-value-props__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="zinsett-value-props__item" {{ block.shopify_attributes }}>
          <span class="zinsett-value-props__icon svg-wrapper" aria-hidden="true">
            {{ block.settings.icon | append: '.svg' | inline_asset_content }}
          </span>
          {%- if block.settings.heading != blank -%}
            <h3 class="zinsett-value-props__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="zinsett-value-props__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ZINSETT Value props",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Optional. Brief §6 shows the value props with no section heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value prop",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "icon-paw-print", "label": "Paw print" },
            { "value": "icon-truck", "label": "Truck" },
            { "value": "icon-return", "label": "Return" },
            { "value": "icon-heart", "label": "Heart" },
            { "value": "icon-lock", "label": "Lock" }
          ],
          "default": "icon-paw-print"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "No sentence-level copy in the Brief yet — leave blank until copy-brand-guardian supplies it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZINSETT Value props",
      "blocks": [
        { "type": "value_prop", "settings": { "icon": "icon-paw-print", "heading": "Curated by pet people" } },
        { "type": "value_prop", "settings": { "icon": "icon-truck", "heading": "Tracked US delivery" } },
        { "type": "value_prop", "settings": { "icon": "icon-return", "heading": "Easy returns" } }
      ]
    }
  ]
}
{% endschema %}
