{% comment %}
  ZINSETT CategoryTiles — Design Brief §5 CategoryTile / §6 Home #2.

  Four tiles: Dogs / Cats / Birds (NEW badge) / Home. Each block links a
  real Shopify collection (so the URL and fallback title always match the
  live catalog) with an optional art-directed image override for the
  branded lifestyle photo called for in Brief §10 (H-2 Cats, H-3 Dogs,
  H-4 Birds). A "Home" tile block should point at whichever Home & Garden
  hub collection the merchant creates.

  Image + serif label + thin gold rule per the CategoryTile component spec
  (§5); "NEW" badge is a tile-scoped pill (not the shared BadgePill snippet,
  which C-4 introduces for product cards — reconcile styles there).

  Asset slots awaiting media-forge: H-2 (Cats), H-3 (Dogs), H-4 (Birds).
  The Home tile has no Brief §10 photo brief yet — flagged, not invented.
{% endcomment %}
{{ 'section-zinsett-category-tiles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="zinsett-category-tiles page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="zinsett-category-tiles__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <ul class="zinsett-category-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_image = block.settings.image
          if tile_image == blank
            assign tile_image = block.settings.collection.featured_image
          endif
          assign tile_title = block.settings.title
          if tile_title == blank
            assign tile_title = block.settings.collection.title
          endif
          assign tile_url = block.settings.collection.url
          if block.settings.link != blank
            assign tile_url = block.settings.link
          endif
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
        -%}
        <li class="zinsett-category-tiles__item" {{ block.shopify_attributes }}>
          <a
            class="zinsett-category-tile"
            {% if tile_url == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ tile_url }}"
            {% endif %}
          >
            <span class="zinsett-category-tile__media media">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 700
                  | image_tag:
                    widths: '165, 330, 535, 750, 1000',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                    class: 'zinsett-category-tile__image',
                    loading: 'lazy'
                %}
              {%- else -%}
                {{ 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg zinsett-category-tile__image' }}
              {%- endif -%}
              {%- if block.settings.show_badge -%}
                <span class="zinsett-category-tile__badge">{{ block.settings.badge_text | escape }}</span>
              {%- endif -%}
            </span>
            <span class="zinsett-category-tile__label-wrap">
              <span class="zinsett-category-tile__label">
                {%- if tile_title != blank -%}
                  {{- tile_title | escape -}}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </span>
              <span class="zinsett-category-tile__rule" aria-hidden="true"></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ZINSETT Category tiles",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Optional. Brief §6 shows the tiles with no section heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Powers the link and fallback title/image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Art-directed lifestyle photo (Brief §10). Falls back to the collection image when blank."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label override",
          "info": "Falls back to the collection title when blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Falls back to the collection URL when blank."
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "NEW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZINSETT Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Dogs" } },
        { "type": "tile", "settings": { "title": "Cats" } },
        { "type": "tile", "settings": { "title": "Birds", "show_badge": true, "badge_text": "NEW" } },
        { "type": "tile", "settings": { "title": "Home" } }
      ]
    }
  ]
}
{% endschema %}
