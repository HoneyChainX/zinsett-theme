{% comment %}
  ZINSETT CategoryTiles / "Aisle" tiles — Design Brief §5 CategoryTile /
  §6 Home #2, structural follow-up per FINAL-SPEC §2 ".aisle" + §3
  "Aisles" row.

  Four tiles: Dogs / Cats / Birds (NEW badge) / Home. Each block links a
  real Shopify collection (so the URL and fallback title always match the
  live catalog) with an optional art-directed image override for the
  branded lifestyle photo called for in Brief §10 (H-2 Cats, H-3 Dogs,
  H-4 Birds). A "Home" tile block should point at whichever Home & Garden
  hub collection the merchant creates.

  Aisle anatomy (FINAL-SPEC §2 ".aisle"): giant outlined numeral (wood-type
  numeral, transparent fill + kraft-deep stroke, low-contrast) from
  `forloop.index` → "AISLE 0N" mono kicker → collection title → LIVE item
  count from `collection.products_count` (never hardcoded — FINAL-SPEC
  §4 judge-fix 7) → small well-mounted product thumb (multiplied cutout,
  top-right, decorative) → corner arrow. Variant color (green/cream/kraft)
  is block-schema-driven per §2's "Variants: green (Cats), cream
  (Dogs/Home), kraft (Birds)".

  "NEW" badge is a tile-scoped pill (not the shared BadgePill snippet,
  which C-4 introduces for product cards — reconcile styles there).

  Asset slots awaiting media-forge: H-2 (Cats), H-3 (Dogs), H-4 (Birds).
  The Home tile has no Brief §10 photo brief yet — flagged, not invented.

  Schema compatibility note: every setting ID that existed before this
  pass (title, color_scheme, padding_top, padding_bottom, collection,
  image, title [block], link, show_badge, badge_text) is kept as-is; only
  new settings (block `variant`) were added, with a default so existing
  saved section/block data keeps validating.
{% endcomment %}
{%- comment -%}
  Perf pass: CategoryTiles is Home #2, typically below the hero on the
  mobile viewport Lighthouse audits against — async per Dawn's
  print/onload swap idiom instead of a blocking stylesheet_tag. The hero
  above it (section-zinsett-hero-editorial.css) stays blocking since it
  carries the LCP element.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'section-zinsett-category-tiles.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="zinsett-category-tiles page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="zinsett-category-tiles__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <ul class="zinsett-category-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_image = block.settings.image
          if tile_image == blank
            assign tile_image = block.settings.collection.featured_image
          endif
          assign tile_title = block.settings.title
          if tile_title == blank
            assign tile_title = block.settings.collection.title
          endif
          assign tile_url = block.settings.collection.url
          if block.settings.link != blank
            assign tile_url = block.settings.link
          endif
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1

          # Giant aisle numeral, always 2 digits ("01", "02" …) — Aisle
          # anatomy, FINAL-SPEC §2. Zero-pad by prepending then slicing
          # the last 2 characters so it stays correct beyond 9 tiles too.
          assign aisle_padded = forloop.index | prepend: '00'
          assign aisle_number = aisle_padded | slice: -2, 2

          # Alternate well tint (Sunroom graft, FINAL-SPEC §1.2/§4) so the
          # thumbs don't checkerboard: cool on the 1st/3rd tile, warm on
          # the 2nd/4th — art-directed, not literal odd/even of the loop.
          assign well_variant = 'zinsett-aisle__thumb-well'
          if forloop.index == 1 or forloop.index == 3
            assign well_variant = 'zinsett-aisle__thumb-well zinsett-aisle__thumb-well--cool'
          endif
        -%}
        <li class="zinsett-category-tiles__item" {{ block.shopify_attributes }}>
          <a
            class="zinsett-aisle zinsett-aisle--{{ block.settings.variant }}"
            {% if tile_url == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ tile_url }}"
            {% endif %}
          >
            <span class="zinsett-aisle__numeral" aria-hidden="true">{{ aisle_number }}</span>

            <span class="{{ well_variant }}">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 300
                  | image_tag:
                    widths: '150, 220, 300',
                    sizes: '96px',
                    class: 'zinsett-aisle__thumb-image',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg zinsett-aisle__thumb-image' }}
              {%- endif -%}
              {%- if block.settings.show_badge -%}
                <span class="zinsett-aisle__badge">{{ block.settings.badge_text | escape }}</span>
              {%- endif -%}
            </span>

            <span class="zinsett-aisle__body">
              <span class="zinsett-aisle__kicker">
                {{- 'sections.zinsett_category_tiles.aisle_kicker' | t: number: aisle_number -}}
              </span>
              <span class="zinsett-aisle__label">
                {%- if tile_title != blank -%}
                  {{- tile_title | escape -}}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </span>
              {%- if block.settings.collection != blank -%}
                <span class="zinsett-aisle__count">
                  {{- 'general.zinsett_aisle_item_count' | t: count: block.settings.collection.products_count -}}
                </span>
              {%- endif -%}
            </span>

            <span class="zinsett-aisle__arrow" aria-hidden="true"></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ZINSETT Category tiles",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Optional. Brief §6 shows the tiles with no section heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Powers the link, fallback title/image, and the live item count."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Art-directed lifestyle photo (Brief §10). Falls back to the collection image when blank."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label override",
          "info": "Falls back to the collection title when blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Falls back to the collection URL when blank."
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Aisle variant",
          "info": "FINAL-SPEC §2 \".aisle\" color variants.",
          "options": [
            { "value": "cream", "label": "Cream (Dogs/Home)" },
            { "value": "green", "label": "Green (Cats)" },
            { "value": "kraft", "label": "Kraft (Birds)" }
          ],
          "default": "cream"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "NEW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZINSETT Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Dogs", "variant": "cream" } },
        { "type": "tile", "settings": { "title": "Cats", "variant": "green" } },
        { "type": "tile", "settings": { "title": "Birds", "variant": "kraft", "show_badge": true, "badge_text": "NEW" } },
        { "type": "tile", "settings": { "title": "Home", "variant": "cream" } }
      ]
    }
  ]
}
{% endschema %}
