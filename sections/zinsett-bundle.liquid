{% comment %}
  ZINSETT BundleBlock — Design Brief §5 BundleBlock / §6 Home #4.

  "Backyard Oasis" (Solar Bird-Bath Fountain + Glass Hummingbird Feeder,
  $69, save $5). Each item block can link a real product (so price/name
  come from the catalog once those SKUs exist) or fall back to plain text
  if the merchant hasn't set one yet. Bundle price/savings and the CTA
  label are plain schema text — Shopify Basic has no native bundle object,
  so this is a promo block pointing at wherever the merchant sells the
  bundle (a bundle product, or a cart permalink).

  Asset slot awaiting media-forge: Brief §10 H-6 (solar fountain + glass
  feeder, lush patio, 16:9).

  Copy note: "Backyard Oasis" / "$69" / "save $5" are given verbatim in
  Brief §6. The CTA label default ("Shop the bundle") and any longer
  description are NOT in Brief §9 — flagged as placeholder pending
  copy-brand-guardian sign-off, left schema-editable.
{% endcomment %}
{{ 'section-zinsett-bundle.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="zinsett-bundle page-width section-{{ section.id }}-padding">
    <div class="zinsett-bundle__media media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag:
            widths: '375, 550, 750, 1100, 1500',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'zinsett-bundle__image',
            loading: 'lazy'
        %}
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg zinsett-bundle__image' }}
      {%- endif -%}
    </div>

    <div class="zinsett-bundle__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zinsett-bundle__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zinsett-bundle__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="zinsett-bundle__description">{{ section.settings.description }}</div>
      {%- endif -%}

      <ul class="zinsett-bundle__items" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_title = block.settings.title
            if item_title == blank and block.settings.product != blank
              assign item_title = block.settings.product.title
            endif
          -%}
          <li class="zinsett-bundle__item" {{ block.shopify_attributes }}>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="zinsett-bundle__item-link">
                {{- item_title | escape -}}
              </a>
            {%- else -%}
              <span>{{ item_title | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <p class="zinsett-bundle__price-row">
        {%- if section.settings.bundle_price != blank -%}
          <span class="zinsett-bundle__price">{{ section.settings.bundle_price | escape }}</span>
        {%- endif -%}
        {%- if section.settings.original_price != blank -%}
          <span class="zinsett-bundle__price-compare">{{ section.settings.original_price | escape }}</span>
        {%- endif -%}
        {%- if section.settings.savings_label != blank -%}
          <span class="zinsett-bundle__savings">{{ section.settings.savings_label | escape }}</span>
        {%- endif -%}
      </p>

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ZINSETT Bundle",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Backyard Oasis bundle (Brief §6 Home #4). Awaiting media-forge asset H-6 (solar fountain + glass feeder, lush patio)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Backyard Oasis"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "No final copy in the Brief yet — leave blank until copy-brand-guardian supplies it."
    },
    {
      "type": "text",
      "id": "bundle_price",
      "label": "Bundle price",
      "default": "$69"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original price (struck through)",
      "default": "$74"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings label",
      "default": "Save $5"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the bundle",
      "info": "Placeholder — not a Brief §9 string. Update once copy-brand-guardian confirms."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle item",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Links to the real product once it exists in the catalog."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Falls back to the product title when blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZINSETT Bundle",
      "settings": {
        "eyebrow": "Bundle",
        "heading": "Backyard Oasis",
        "bundle_price": "$69",
        "original_price": "$74",
        "savings_label": "Save $5",
        "button_label": "Shop the bundle"
      },
      "blocks": [
        { "type": "item", "settings": { "title": "Solar Bird-Bath Fountain" } },
        { "type": "item", "settings": { "title": "Glass Hummingbird Feeder 2-pack" } }
      ]
    }
  ]
}
{% endschema %}
